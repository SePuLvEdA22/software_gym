# BodyFitGym - Environment Variables
#
# Copy this file to .env and adjust values as needed.

# GYM_MODE: Controls the application window mode
#   admin  - Show admin window only (default)
#   kiosk  - Show kiosk/touchscreen window only
#   both   - Show both admin and kiosk windows
GYM_MODE=admin

# SENTRY_DSN: Sentry Data Source Name for error monitoring
# Get your DSN from: https://sentry.io/settings/projects/
# If not set, Sentry will not be initialized.
SENTRY_DSN=
