# BodyFitGym - Environment Variables
#
# Copy this file to .env and adjust values as needed.

# GYM_MODE: Controls the application window mode
#   admin  - Show admin window only (default)
#   kiosk  - Show kiosk/touchscreen window only
#   both   - Show both admin and kiosk windows
GYM_MODE=admin

# SENTRY_DSN: Sentry Data Source Name for error monitoring
# Get your DSN from: https://sentry.io/settings/projects/
# If not set, Sentry will not be initialized.
#
# IMPORTANTE: el DSN se HORNEA en el bundle durante el build (electron.vite.config.ts).
# - En desarrollo: define aquí la variable y reinicia `npm run dev`.
# - En producción: se toma del secret SENTRY_DSN del repositorio (Settings → Secrets → Actions),
#   que el workflow release.yml pasa al build automáticamente.
SENTRY_DSN=
