{
  "name": "bodyfitgym",
  "version": "1.0.3",
  "description": "Sistema profesional de administracion y control de acceso para BodyFitGym",
  "main": "./out/main/index.js",
  "author": "BodyFitGym",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.bodyfitgym.app",
    "productName": "BodyFitGym",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "SePuLvEdA22",
      "repo": "software_gym"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:legacy": "npx tsx scripts/migrate-legacy-data.ts",
    "migrate:import": "npx tsx scripts/import-migrated-data.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@sentry/electron": "^7.13.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "electron-log": "^5.1.5",
    "electron-updater": "^6.8.9",
    "jimp": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "sql.js": "^1.14.1",
    "uuid": "^11.1.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.8"
  }
}
